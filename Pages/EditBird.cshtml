@page
@model EditBirdModel
@{
    ViewData["Title"] = "Kuşu Düzenle";
}

<div class="container mt-4">
    <h2>Kuş Bilgilerini Güncelle</h2>
    <form method="post" class="col-md-6">
        @* ID'yi gizli tutuyoruz ki hangi kuşu güncellediğimizi sistem bilsin *@
        <input type="hidden" asp-for="BirdToEdit.BirdID" />

        <div class="mb-3">
            <label class="form-label">Kuşun Adı</label>
            <input asp-for="BirdToEdit.CommonName" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Tür (Species)</label>
            <input asp-for="BirdToEdit.Species" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Kanat Açıklığı (cm)</label>
            <input asp-for="BirdToEdit.WingSpan" class="form-control" type="number" step="0.01" />
        </div>

        <div class="mb-3">
            <label class="form-label">Nesli Tükenme Durumu</label>
            <input asp-for="BirdToEdit.EndangeredStatus" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Renk</label>
            <input asp-for="BirdToEdit.Color" class="form-control" />
        </div>

        @* --- ŞEKERİM BURASI BİZİM EKLEDİĞİMİZ GÖZLEM DETAYLARI --- *@
        <hr />
        <h5 class="text-primary">Gözlem Detaylarını Güncelle</h5>

        <div class="mb-3">
            <label class="form-label fw-bold">Gözlem Yapılan Konum</label>
            <select asp-for="SelectedLocationId" asp-items="Model.Locations" class="form-select border-primary">
                <option value="">-- Konum Seç --</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Hava Durumu</label>
            <select asp-for="SelectedWeatherId" asp-items="Model.WeatherList" class="form-select border-primary">
                <option value="">-- Hava Durumu Seç --</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">📝 Gözlem Notlarını Güncelle</label>
            <textarea asp-for="Notes" class="form-control" rows="3"
                      placeholder="Notlarını buradan düzenleyebilirsin şekerim..."></textarea>
        </div>
        @* --------------------------------------------------- *@

        <button type="submit" class="btn btn-warning">Tüm Değişiklikleri Kaydet</button>
        <a asp-page="Index" class="btn btn-secondary">İptal</a>
    </form>
</div>